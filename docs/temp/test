docker run --name my-local-postgres \
  -e POSTGRES_USER=transcendence_user \
  -e POSTGRES_PASSWORD=transcendence_pass \
  -e POSTGRES_DB=transcendence_db \
  -p 5432:5432 \
  -d postgres:16-alpine

docker exec -i my-local-postgres psql -U transcendence_user -d transcendence_db << 'EOF'
CREATE TABLE IF NOT EXISTS users (
  id SERIAL PRIMARY KEY,
  username VARCHAR(50) UNIQUE NOT NULL,
  email VARCHAR(255) UNIQUE NOT NULL,
  password VARCHAR(255) NOT NULL,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);
EOF

docker exec -it my-local-postgres psql -U transcendence_user -d transcendence_db

docker logs my-local-postgres

docker stop my-local-postgres

docker start my-local-postgres

curl http://localhost:3000/api/health

curl -X POST http://localhost:3000/api/auth/register \
  -H "Content-Type: application/json" \
  -d '{"username":"testuser","email":"test@example.com","password":"password123"}'

curl -X POST http://localhost:3000/api/auth/login \
  -H "Content-Type: application/json" \
  -d '{"identifier":"testuser","password":"password123"}' -i

curl -X POST http://localhost:3000/api/auth/logout \
  -H "Content-Type: application/json" \
  -i

curl -k -i https://localhost:3000/api/auth/me

curl -k -i -X POST https://localhost:3000/api/auth/login \
  -H "Content-Type: application/json" \
  -d '{"identifier":"test@example.com", "password":"password123"}' \
  -c cookies.txt

curl -k -i -b cookies.txt https://localhost:3000/api/auth/me

curl -k -i -X POST https://localhost:3000/api/auth/logout -b cookies.txt

curl -k -i https://localhost:3000/api/users/me

curl -k -i -b cookies.txt https://localhost:3000/api/users/me