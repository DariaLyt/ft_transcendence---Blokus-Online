# Copy this file to .env and replace the secrets.
# Docker Compose overrides DB_HOST (db) and GO_ENGINE_URL (game:50051) inside the backend container.

PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=blokus
DB_PASSWORD=change-me
DB_NAME=blokus_db

JWT_SECRET=change-me-to-a-long-random-string

AVATAR_UPLOAD_DIR=uploads/avatars
GO_ENGINE_URL=localhost:50051
DEMO_PASSWORD=change-me
